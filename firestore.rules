rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/ek_admin_accounts/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/ek_admin_accounts/$(request.auth.uid)).data.get('role', 'admin') == 'admin' || 
          get(/databases/$(database)/documents/ek_admin_accounts/$(request.auth.uid)).data.get('role', 'admin') == 'superadmin'
        ) && 
        get(/databases/$(database)/documents/ek_admin_accounts/$(request.auth.uid)).data.get('active', true) != false;
    }

    function isRider() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/ek_delivery_persons/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/ek_delivery_persons/$(request.auth.uid)).data.get('active', true) != false &&
        get(/databases/$(database)/documents/ek_delivery_persons/$(request.auth.uid)).data.get('isActive', true) != false;
    }

    function isCustomerOrderUpdate(currentData, nextData) {
      return currentData.id == nextData.id &&
             (currentData.customerId == request.auth.uid || currentData.userId == request.auth.uid) &&
             currentData.userId == nextData.userId &&
             currentData.customerId == nextData.customerId &&
             currentData.totalAmount == nextData.totalAmount &&
             currentData.subtotalAmount == nextData.subtotalAmount &&
             currentData.items == nextData.items &&
             currentData.get('deliveryFee', 0) == nextData.get('deliveryFee', 0) &&
             currentData.get('discount', 0) == nextData.get('discount', 0) &&
             currentData.get('assignedTo', null) == nextData.get('assignedTo', null) &&
             currentData.get('riderUid', null) == nextData.get('riderUid', null) &&
             currentData.get('paymentStatus', '') == nextData.get('paymentStatus', '') &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancellationReason', 'cancelReason', 'userNotes', 'feedbackComment', 'feedbackRating', 'riderRating', 'riderFeedback', 'updatedAt', 'rating', 'feedbackSubmittedAt', 'deliveryLatitude', 'deliveryLongitude', 'needsManualLocationPin', 'notes', 'aiResolved', 'aiResolutionTimestamp']) &&
             (
               currentData.status == nextData.status ||
               (currentData.status == 'pending' && (nextData.status == 'cancelled' || nextData.status == 'CANCELLED'))
             );
    }

    function isRiderUpdate(currentData, nextData) {
      return currentData.id == nextData.id &&
             (currentData.customerId == nextData.customerId || currentData.userId == nextData.userId) &&
             currentData.customerPhone == nextData.customerPhone &&
             currentData.customerName == nextData.customerName &&
             currentData.deliveryAddress == nextData.deliveryAddress &&
             currentData.subtotalAmount == nextData.subtotalAmount &&
             currentData.totalAmount == nextData.totalAmount &&
             currentData.items == nextData.items &&
             currentData.createdAt == nextData.createdAt &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveryStatus', 'assignedTo', 'riderUid', 'riderLocation', 'currentLocation', 'riderLatitude', 'riderLongitude', 'updatedAt', 'deliveredAt', 'pickedUpAt', 'deliveryNotes', 'riderNotes', 'orderStatusHistory', 'timeline', 'riderAssignedAt', 'arrivedAtStoreAt', 'deliveryProofUrl', 'otpVerified', 'deliveryConfirmationOtp', 'signatureUrl', 'customerSignature', 'handoverType', 'handoverProof']) &&
             (
               (nextData.get('assignedTo', {}) != null && nextData.get('assignedTo', {}).get('id', '') == request.auth.uid) ||
               nextData.get('riderUid', '') == request.auth.uid || 
               nextData.get('assignedExecutiveId', '') == request.auth.uid || 
               nextData.get('deliveryExecutiveId', '') == request.auth.uid ||
               nextData.get('assignedDeliveryPartnerUid', '') == request.auth.uid ||
               nextData.get('riderId', '') == request.auth.uid ||
               nextData.get('deliveryPartnerUid', '') == request.auth.uid
             ) &&
             (
               (currentData.get('assignedTo', {}) != null && currentData.get('assignedTo', {}).get('id', '') == request.auth.uid) ||
               currentData.get('riderUid', '') == request.auth.uid || 
               currentData.get('assignedExecutiveId', '') == request.auth.uid || 
               currentData.get('deliveryExecutiveId', '') == request.auth.uid ||
               currentData.get('assignedDeliveryPartnerUid', '') == request.auth.uid ||
               currentData.get('riderId', '') == request.auth.uid ||
               currentData.get('deliveryPartnerUid', '') == request.auth.uid
             ) && (
               // Transition A: Ready -> Delivering / OUT_FOR_DELIVERY
               ((currentData.status == 'ready' || currentData.status == 'ACCEPTED' || currentData.status == 'pending') && (nextData.status == 'delivering' || nextData.status == 'OUT_FOR_DELIVERY' || nextData.status == 'ready')) ||
               // Transition B: Delivering -> Delivered
               ((currentData.status == 'delivering' || currentData.status == 'OUT_FOR_DELIVERY') && (nextData.status == 'delivered' || nextData.status == 'DELIVERED')) ||
               // Transition C: Location/Progress update (status remains unchanged)
               (currentData.status == nextData.status)
             );
    }

    function isRiderAssignedToOrder(orderData) {
      return (orderData.get('assignedTo', {}) != null && orderData.get('assignedTo', {}).get('id', '') == request.auth.uid) ||
             orderData.get('riderUid', '') == request.auth.uid || 
             orderData.get('assignedExecutiveId', '') == request.auth.uid || 
             orderData.get('deliveryExecutiveId', '') == request.auth.uid ||
             orderData.get('assignedDeliveryPartnerUid', '') == request.auth.uid ||
             orderData.get('riderId', '') == request.auth.uid ||
             orderData.get('deliveryPartnerUid', '') == request.auth.uid ||
             (orderData.get('status', '') in ['ready', 'ACCEPTED'] && orderData.get('assignedTo', null) == null);
    }

    // Orders: customers can create and read/update own (safe fields only), admin can do everything, riders can read assigned and operational update
    match /ek_orders/{orderId} {
      allow get: if isAdmin() || resource == null || (isRider() && isRiderAssignedToOrder(resource.data)) || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.customerId == request.auth.uid));
      allow list: if isAdmin() || (isRider() && isRiderAssignedToOrder(resource.data)) || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.customerId == request.auth.uid));
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          (request.resource.data.userId == request.auth.uid || request.resource.data.customerId == request.auth.uid || request.resource.data.get('customerPhone', '') != '') &&
          request.resource.data.get('stockDeducted', false) == false &&
          request.resource.data.get('status', 'pending') in ['pending', 'PENDING', 'placed', 'PLACED', 'payment_pending_verification'] &&
          (
            !('paymentStatus' in request.resource.data) ||
            request.resource.data.paymentStatus != 'PAID' ||
            request.resource.data.get('paymentMethod', '') in ['COD', 'CASH_ON_DELIVERY', 'cod', 'cash_on_delivery', 'Cash on Delivery (COD)'] ||
            request.resource.data.get('paymentMethod', '').matches('.*UPI.*') ||
            request.resource.data.get('paymentMethod', '').matches('.*COD.*')
          )
        )
      );
      allow update: if isAdmin() || 
                    (isAuthenticated() && isCustomerOrderUpdate(resource.data, request.resource.data)) || 
                    (isRider() && isRiderUpdate(resource.data, request.resource.data));
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, write: if isAdmin();
      allow delete: if false;
    }

    // Users: allow owner or admin to read/write profiles to secure customer PII
    match /ek_users/{userId} {
      allow get: if isAdmin() || resource == null || (isAuthenticated() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId && (!request.resource.data.keys().hasAny(['role', 'isAdmin', 'isRider']) || request.resource.data.get('role', 'customer') == 'customer');
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'isRider', 'active', 'isActive', 'isBlocked', 'disabled']));
      allow delete: if isAdmin();
    }

    // Legacy/Simplification users collection
    match /users/{userId} {
      allow get: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && (!request.resource.data.keys().hasAny(['role', 'isAdmin', 'isRider']) || request.resource.data.get('role', 'customer') == 'customer'));
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'isRider', 'active', 'isActive', 'isBlocked', 'disabled', 'tier']));
      allow delete: if isAdmin();
    }

    // Legacy/Simplification settings collection
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products: anyone can read, only admin can write (stock is deducted/restored via Cloud Functions with Admin SDK)
    match /ek_products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories: anyone can read, only admin writes
    match /ek_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons: anyone can read, only Cloud Function (Admin SDK) & Admins write. Regular clients cannot write to ek_coupons.
    match /ek_coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Delivery Zones: anyone can read, only admin writes
    match /ek_delivery_zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners: anyone can read, only admin writes
    match /ek_banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews: anyone can read, creator or admin can write
    match /ek_reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.customerId == request.auth.uid
      );
      allow update, delete: if isAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid || 
          resource.data.customerId == request.auth.uid
        )
      );
    }

    function isAllowedFcmQueueCreate() {
      return isAdmin() || (
        isAuthenticated() &&
        request.resource.data.get('title', '') is string &&
        request.resource.data.get('title', '').size() <= 200 &&
        request.resource.data.get('body', '') is string &&
        request.resource.data.get('body', '').size() <= 500 &&
        (!('topic' in request.resource.data) || request.resource.data.topic == '') &&
        (!('broadcast' in request.resource.data) || request.resource.data.broadcast == false) &&
        (!('audience' in request.resource.data) || request.resource.data.audience != 'all') &&
        (
          ('orderId' in request.resource.data && request.resource.data.orderId is string && request.resource.data.orderId.size() > 0) ||
          (request.resource.data.get('targetUserId', '') == request.auth.uid) ||
          isRider()
        )
      );
    }

    // FCM queue: validated authenticated users can enqueue legitimate order notifications; admin full control
    match /ek_fcm_queue/{docId} {
      allow create: if isAllowedFcmQueueCreate();
      allow read, update, delete: if isAdmin();
    }

    match /ek_topic_broadcast_requests/{docId} {
      allow read, write: if isAdmin();
    }

    // Push Notifications: Admin has full access; customers can only read broadcasts or notifications sent to them
    match /ek_push_notifications/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.get('audience', 'all') == 'all' || resource.data.get('targetUserId', '') == request.auth.uid));
      allow write: if isAdmin();
    }

    // Admin accounts: admin can read all, user can get their own doc, prevent general listing by customers
    match /ek_admin_accounts/{docId} {
      allow get: if isAdmin() || (isAuthenticated() && request.auth.uid == docId);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Delivery persons: admin has full writes, authenticated users can get rider profile (for live order tracking), rider can update operational status/location fields
    match /ek_delivery_persons/{docId} {
      allow get: if isAdmin() || isAuthenticated();
      allow list: if isAdmin();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == docId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['latitude','longitude','accuracy','lastLiveUpdate','lastSeen','availabilityStatus','isOnline','currentLocation','updatedAt']));
    }

    // Email OTP / SMS Config / AI Config / secrets settings: ADMIN-ONLY read/write (contains credentials)
    match /ek_settings/emailConfig {
      allow read, write: if isAdmin();
    }
    match /ek_settings/smsConfig {
      allow read, write: if isAdmin();
    }
    match /ek_settings/ai_provider_config {
      allow read, write: if isAdmin();
    }
    // Settings: anyone can read non-sensitive configs, only admin writes
    match /ek_settings/{docId} {
      allow read: if docId != 'emailConfig' && docId != 'smsConfig' && docId != 'ai_provider_config' && docId != 'secrets' && docId != 'credentials';
      allow write: if isAdmin();
    }

    // Secrets: deny all client read/write
    match /ek_secrets/{docId} {
      allow read, write: if false;
    }

    // Tombstones: write allowed only for administrators
    match /ek_tombstones/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Meta: allow anyone to read, only admin writes
    match /ek_meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Support Chat: users can read/write own chats, admin can do everything
    match /ek_chats/{chatId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Broadcast Requests (historical admin logs): only admin can read/write
    match /ek_broadcast_requests/{docId} {
      allow read, write: if isAdmin();
    }

    // Customer Broadcasts (local shouts): authenticated create, admin read/write
    match /ek_customer_broadcasts/{docId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Customers profiles: only owner or admin can read/write
    match /ek_customers/{customerId} {
      allow read, write: if isAdmin() || (isAuthenticated() && request.auth.uid == customerId);
    }

    // FCM Logs (push notifications dispatch audit): authenticated create, admin read/write
    match /ek_fcm_logs/{docId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Payment Audit Logs: authenticated create for own user/customer id, admin full access
    match /ek_payment_audit_logs/{docId} {
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        request.resource.data.customerId == request.auth.uid
      );
      allow update, read, delete: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
